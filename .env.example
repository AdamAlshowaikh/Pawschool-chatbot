# Copy this file to .env and pick ONE option. Never commit .env to GitHub.

# Option A (default): Ollama, runs on your own computer, no account, no key, no limits
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2

# Option B: Google Gemini free tier (get a key at aistudio.google.com)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your_gemini_key
# LLM_MODEL=gemini-2.0-flash   # check the current free model name in AI Studio

# Option C: Groq free tier (get a key at console.groq.com)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your_groq_key
# LLM_MODEL=llama-3.1-8b-instant   # check the current free model name in the Groq console

MAX_TURNS=10
